#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Actualiza y publica el catálogo de funcionalidades de Rifero.

Uso:
  update-rifero-status [--dry-run] [--help]

Descarga las referencias main/staging de los repositorios privados hermanos,
regenera el snapshot curado, ejecuta tests y build, y publica sólo data.js en
main si hubo cambios. --dry-run muestra el diff y valida, pero restaura data.js
al terminar, sin commitear ni publicar.
EOF
}

DRY_RUN=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Argumento desconocido: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

fail() { echo "Error: $*" >&2; exit 1; }

command -v git >/dev/null 2>&1 || fail "git no está instalado."
command -v python3 >/dev/null 2>&1 || fail "python3 no está instalado."
command -v node >/dev/null 2>&1 || fail "Node.js no está instalado."
command -v pnpm >/dev/null 2>&1 || fail "pnpm no está instalado. Instala pnpm 10.28.0."

PNPM_VERSION="$(pnpm --version 2>/dev/null)" || fail "No se pudo ejecutar pnpm."
[[ "$PNPM_VERSION" == 10.* ]] || fail "Se requiere pnpm 10.x; se encontró $PNPM_VERSION."

# Resolve symlinked installations (for example ~/Library/pnpm/update-rifero-status).
SCRIPT_PATH="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
WORKSPACE="$(dirname "$ROOT")"
EXPECTED_REMOTE="https://github.com/VictorManuel/rifero-feature-catalog.git"

[[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" == "$ROOT" ]] || fail "El catálogo no está dentro de un repositorio Git."
REMOTE="$(git -C "$ROOT" remote get-url origin 2>/dev/null)" || fail "No existe el remoto origin del catálogo."
case "$REMOTE" in
  "$EXPECTED_REMOTE"|https://github.com/VictorManuel/rifero-feature-catalog|git@github.com:VictorManuel/rifero-feature-catalog.git|ssh://git@github.com/VictorManuel/rifero-feature-catalog.git) ;;
  *) fail "El remoto origin no es el catálogo esperado (VictorManuel/rifero-feature-catalog). No se publicará." ;;
esac

BRANCH="$(git -C "$ROOT" symbolic-ref --short -q HEAD)" || fail "Haz checkout de una rama antes de actualizar."
[[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]] || fail "El catálogo tiene cambios locales. Guárdalos o descártalos antes; no se sobrescribió nada."

echo "→ Verificando main del catálogo..."
git -C "$ROOT" fetch --quiet --no-tags origin refs/heads/main:refs/remotes/origin/main || fail "No se pudo actualizar origin/main del catálogo. Verifica red y permisos de GitHub."
HEAD_SHA="$(git -C "$ROOT" rev-parse HEAD)"
MAIN_SHA="$(git -C "$ROOT" rev-parse refs/remotes/origin/main)"
PENDING_UPDATE=false
if [[ "$HEAD_SHA" != "$MAIN_SHA" ]]; then
  if git -C "$ROOT" merge-base --is-ancestor HEAD refs/remotes/origin/main; then
    git -C "$ROOT" merge --ff-only refs/remotes/origin/main >/dev/null || fail "No se pudo adelantar la rama local a origin/main."
  elif git -C "$ROOT" merge-base --is-ancestor refs/remotes/origin/main HEAD; then
    AHEAD="$(git -C "$ROOT" rev-list --count refs/remotes/origin/main..HEAD)"
    FILES="$(git -C "$ROOT" diff --name-only refs/remotes/origin/main...HEAD)"
    SUBJECT="$(git -C "$ROOT" log -1 --format=%s HEAD)"
    if [[ "$AHEAD" == 1 && "$FILES" == "data.js" && "$SUBJECT" == "chore(catalog): refresh feature status snapshot" ]]; then
      # A previous run may have committed its snapshot but failed to push.
      PENDING_UPDATE=true
    else
      fail "La rama $BRANCH tiene commits que no están en main. Para evitar publicar trabajo ajeno al catálogo, sincronízala primero."
    fi
  else
    fail "La rama $BRANCH diverge de origin/main. Sincronízala antes de actualizar; no se hará reset ni rebase."
  fi
fi

if [[ "$PENDING_UPDATE" == true ]]; then
  echo "→ Reintentando publicar el snapshot pendiente del intento anterior..."
  [[ "$DRY_RUN" == true ]] || git -C "$ROOT" push origin HEAD:refs/heads/main || fail "No se pudo publicar el commit pendiente. La rama local se conservó sin forzar el push."
  if [[ "$DRY_RUN" == false ]]; then
    git -C "$ROOT" fetch --quiet --no-tags origin refs/heads/main:refs/remotes/origin/main || fail "El push funcionó, pero no se pudo refrescar origin/main."
  else
    echo "Dry-run: se omitió el reintento de publicación."
    exit 0
  fi
fi

DRY_RUN_BACKUP=""
restore_dry_run() {
  if [[ -n "$DRY_RUN_BACKUP" && -f "$DRY_RUN_BACKUP" ]]; then
    cp "$DRY_RUN_BACKUP" "$ROOT/data.js"
    rm -f "$DRY_RUN_BACKUP"
    DRY_RUN_BACKUP=""
  fi
}
if [[ "$DRY_RUN" == true ]]; then
  DRY_RUN_BACKUP="$(mktemp "${TMPDIR:-/tmp}/rifero-status.XXXXXX")"
  cp "$ROOT/data.js" "$DRY_RUN_BACKUP"
  trap restore_dry_run EXIT
fi

for repo in web backend email-worker; do
  CHECKOUT="$WORKSPACE/$repo"
  [[ -d "$CHECKOUT" ]] || fail "Falta el checkout hermano $CHECKOUT."
  git -C "$CHECKOUT" rev-parse --git-dir >/dev/null 2>&1 || fail "$CHECKOUT no es un checkout Git."
  case "$repo" in
    web) SOURCE_PROJECT="rifero" ;;
    backend) SOURCE_PROJECT="rifero-backend" ;;
    email-worker) SOURCE_PROJECT="rifero-email-worker" ;;
  esac
  URL="https://github.com/VictorManuel/$SOURCE_PROJECT.git"
  echo "→ Actualizando refs privadas de $repo (sin tocar archivos locales)..."
  if ! GIT_TERMINAL_PROMPT=0 git -C "$CHECKOUT" fetch --quiet --no-tags "$URL" \
    '+refs/heads/main:refs/remotes/origin/main' \
    '+refs/heads/staging:refs/remotes/origin/staging'; then
    fail "No se pudo leer $URL. Comprueba acceso de GitHub a ese repositorio privado. No se usaron refs potencialmente desactualizadas."
  fi
done

echo "→ Regenerando catálogo..."
python3 "$ROOT/generate.py"
echo "→ Ejecutando tests..."
pnpm --dir "$ROOT" test
echo "→ Construyendo sitio..."
pnpm --dir "$ROOT" build

if git -C "$ROOT" diff --quiet -- data.js; then
  echo "✓ El catálogo ya está actualizado. No hay commit ni publicación que hacer."
  exit 0
fi

if [[ "$DRY_RUN" == true ]]; then
  echo "Cambios que publicaría:"
  git -C "$ROOT" diff --stat -- data.js
  restore_dry_run
  trap - EXIT
  echo "Dry-run completo: tests/build pasaron; no quedan cambios locales ni se publicó nada."
  exit 0
fi

git -C "$ROOT" add -- data.js
git -C "$ROOT" diff --cached --check || fail "El snapshot generó errores de whitespace; no se publicó."
STAGED="$(git -C "$ROOT" diff --cached --name-only)"
[[ "$STAGED" == "data.js" ]] || fail "Sólo se permite publicar data.js; se encontraron otros archivos staged."
git -C "$ROOT" commit -m "chore(catalog): refresh feature status snapshot"
echo "→ Publicando snapshot en main..."
git -C "$ROOT" push origin HEAD:refs/heads/main || fail "El commit quedó guardado localmente, pero el push falló. Revisa permisos/estado remoto y vuelve a ejecutar el comando; nunca se fuerza el push."
git -C "$ROOT" fetch --quiet --no-tags origin refs/heads/main:refs/remotes/origin/main || true
echo "✓ Snapshot publicado. GitHub Actions desplegará Pages desde main."
